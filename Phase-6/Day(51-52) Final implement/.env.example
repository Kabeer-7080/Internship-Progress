# ==============================================================================
# FinGuard Backend Environment Configuration
# Production Architecture: Vercel (Frontend) → Railway (FastAPI + MySQL + ML)
# ==============================================================================

# --- JWT Authentication ---
JWT_SECRET=super-secret-finguard-key-change-in-production

# --- CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:5173,https://zonal-love-production-76af.up.railway.app

# --- App Environment ---
ENVIRONMENT=development

# --- Server Port (Railway automatically injects PORT) ---
PORT=8000

# Local default: SQLite. Set DB_ENGINE=mysql when using a local MySQL server.
DB_ENGINE=sqlite


# ==============================================================================
# RAILWAY / CLOUD MYSQL DATABASE CONFIGURATION
# Railway automatically provisions these variables when you add a MySQL plugin:
# ==============================================================================
# Option 1: Discrete Variables
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=finguard
MYSQLUSER=root
MYSQLPASSWORD=your_password_here

# Option 2: Generic DB_* Aliases
# Leave DB_ENGINE=sqlite for zero-configuration local development.
# For local MySQL, set DB_ENGINE=mysql and provide these values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finguard
DB_USER=root
DB_PASSWORD=your_password_here

# Option 3: Single Connection String (Injected automatically by Railway as MYSQL_URL)
# DATABASE_URL=mysql+pymysql://root:password@containers-us-west-1.railway.app:7123/railway?charset=utf8mb4


# ==============================================================================
# CONNECTION POOL TUNING
# ==============================================================================
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
