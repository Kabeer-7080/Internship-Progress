                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "url": "{{baseUrl}}/api/students",
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Test Student\",\n    \"email\": \"test.student@example.com\",\n    \"course\": \"Computer Science\"\n}"
                }
            }
        },
        {
