{
    "info": {
        "_postman_id": "day45-standalone-student-management",
        "name": "Student Management API - Day 45",
        "description": "Complete standalone Day 45 API testing collection.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:5000"
        },
